# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
alias zshconfig="kate ~/.zshrc"
alias ohmyzsh="cd ~/.oh-my-zsh"

#Navigation

alias ..="cd .."
alias ..2="cd ../.."
alias ..3="cd ../../.."
alias ..4="cd ../../../.."
alias ..5="cd ../../../../.."

#Standard options

paru_options()
{
cols=$(tput cols)
if [ -z "$@" ]
then 
  paru --sudoloop --bottomup -Syu
else 
  paru --sudoloop --bottomup "$@"
fi
}
alias paru=paru_options

#SLURM
squeue_formatted()
{
cols=$(tput cols)
if ((${cols}>120))
then 
  squeue --format='%.18i %.9P %.30j %.8u %.2t %.10M %.19S %.6D %R' "$@"
elif ((${cols}>100))
then
  squeue --format='%.18i %.9P %.20j %.8u %.2t %.10M %.6D %R' "$@"
else 
  squeue --format='%.8i %.9P %.10j %.8u %.2t %.10M %.6D %R' "$@"
fi
}
alias squeue=squeue_formatted

#pacman
alias pacman_remove_orphans="sudo pacman -Rns $(pacman -Qtdq)"

#KDE screens
alias screen-ws="kscreen-doctor \
output.DP-2.disable \
output.HDMI-A-1.enable  \
output.HDMI-A-1.mode.1920x1080@60 \
output.HDMI-A-1.position.0,192 \
output.HDMI-A-1.priority.2 \
output.DP-3.enable \
output.DP-3.mode.2560x1440@144 \
output.DP-3.position.1920,0 \
output.DP-3.priority.1"

alias screen-beamer="kscreen-doctor \
output.HDMI-A-1.disable  \
output.DP-3.disable \
output.DP-2.enable \
output.DP-2.mode.1920x1080@60 \
"

